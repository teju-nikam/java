package dkte.com;

public class Operators {

	public static void main(String[] args) {
		// operators
		int a = 1;
		int b = 2;
		int sum = a + b ;
		int diff = a-b;
		int mult = a*b;
		int div = a%b;
		int mod = a/b;
		System.out.println(sum);
		System.out.println(diff);
		System.out.println(mult);
		System.out.println(div);
		System.out.println(mod);
		

	}

}
