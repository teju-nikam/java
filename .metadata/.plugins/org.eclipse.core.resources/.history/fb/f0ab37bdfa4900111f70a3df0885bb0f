package dkte.com;

import java.util.Scanner;

public class Input {

	public static void main(String[] args) {
		// How to take input
		Scanner sc = new Scanner(System.in);
		System.out.println("Input your age:");
		int age = sc.nextInt();
		System.out.println(age);
		//for float value
		float age1 = sc.nextFloat();
		System.out.println(age1);
		

	}

}
